# Server credentials. Never bundle this file or real values into Flutter.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
VERIFIER_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25
VERIFICATION_MAX_REPAIRS=1
VERIFICATION_BUDGET_SECONDS=80
LLM_PROVIDER=groq
LOCAL_LLM_REASONING_EFFORT=none
USE_LOCAL_LLM=false
DISABLE_CLOUD_LLM_FALLBACK=false
ALLOW_CLINICAL_CLOUD_PROCESSING=false
CLINICAL_USE_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
MODEL_ARTIFACT_PATH=ml/artifacts/model.json
MODEL_ARTIFACT_SHA256=
GUIDELINES_DIR=./guidelines
EVIDENCE_MANIFEST_PATH=guidelines/manifest.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_KNOWLEDGE_GRAPH=false
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Research predictor: kaggle or pic. Restart backend after changing.
RESEARCH_ML_MODEL=kaggle
